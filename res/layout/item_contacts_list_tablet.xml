<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="10dp"
    android:paddingTop="3dp"
    android:paddingRight="10dp"
    android:paddingBottom="3dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/frameIcon"
        android:layout_width="@dimen/listtype_icon_size_tablet"
        android:layout_height="@dimen/listtype_icon_size_tablet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:layout_toEndOf="@+id/frameIcon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/frameIcon"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textSize="@dimen/listtype_text_size_tablet"
            android:textColor="@android:color/primary_text_light"
            android:id="@+id/textName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name"
            android:lines="1"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="20dp"
            android:ellipsize="end"
            android:id="@+id/textOrganization"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Organization"
            android:lines="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
