                        android:padding="2dp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/bg_tile_01"/>
                    <ImageView
                        android:padding="2dp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/bg_tile_01"/>
                    <ImageView
                        android:padding="2dp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/bg_tile_01"/>
                    <ImageView
                        android:padding="2dp"
                        android:layout_width="25dp"
