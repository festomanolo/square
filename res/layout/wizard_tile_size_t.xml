                    <ImageView
                        android:padding="2dp"
                        android:layout_width="33.3dp"
                        android:layout_height="33.3dp"
                        android:src="@drawable/bg_tile_01"/>
                    <ImageView
                        android:padding="2dp"
                        android:layout_width="33.3dp"
                        android:layout_height="33.3dp"
                        android:src="@drawable/bg_tile_01"/>
                    <ImageView
                        android:padding="2dp"
                        android:layout_width="33.3dp"
                        android:layout_height="33.3dp"
                        android:src="@drawable/bg_tile_01"/>
                </GridLayout>
                <GridLayout
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:id="@+id/table4"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:rowCount="4">
                    <ImageView
                        android:padding="2dp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/bg_tile_01"/>
                    <ImageView
                        android:padding="2dp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/bg_tile_01"/>
                    <ImageView
                        android:padding="2dp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/bg_tile_01"/>
                    <ImageView
                        android:padding="2dp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/bg_tile_01"/>
                    <ImageView
                        android:padding="2dp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/bg_tile_01"/>
                    <ImageView
                        android:padding="2dp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/bg_tile_01"/>
                    <ImageView
                        android:padding="2dp"
