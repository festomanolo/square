<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp100"
    android:layout_height="@dimen/dp100">
    <com.example.square.view.MarqueeImageView
        android:id="@+id/imageFull"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="@dimen/text_normal"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/textNoti"
        android:padding="3dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:maxLines="3"
        app:layout_constraintBottom_toTopOf="@+id/textLabel"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="top|center_horizontal"
        android:id="@+id/layoutIcon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_margin="@dimen/margin_for_badge"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|bottom"
                android:id="@+id/dot"
                android:background="@drawable/bg_deco_bubble"
                android:padding="@dimen/bubble_padding"
                android:visibility="invisible"
                android:layout_width="@dimen/badge_size"
                android:layout_height="@dimen/badge_size"/>
        </FrameLayout>
        <com.example.square.NotiCountView
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/text_large"
            android:gravity="center"
            android:id="@+id/textCount"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"/>
    </LinearLayout>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="@dimen/text_normal"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/textLabel"
        android:paddingLeft="@dimen/tile_padding"
        android:paddingRight="@dimen/tile_padding"
        android:paddingBottom="@dimen/tile_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
