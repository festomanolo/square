<?xml version="1.0" encoding="utf-8"?>
<view xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/logo"
    android:layout_width="@dimen/logo_size"
    android:layout_height="@dimen/logo_size"
    class="com.example.square.WizardActivity$LogoView">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/logo1"
        android:padding="3dp"
        android:layout_width="@dimen/logo_block_w"
        android:layout_height="@dimen/logo_block_h"
        android:src="@drawable/logo_block"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/logo2"
        android:padding="3dp"
        android:layout_width="@dimen/logo_block_h"
        android:layout_height="@dimen/logo_block_w"
        android:src="@drawable/logo_block"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/logo3"
        android:padding="3dp"
        android:layout_width="@dimen/logo_block_h"
        android:layout_height="@dimen/logo_block_w"
        android:src="@drawable/logo_block"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <com.example.square.view.AnimateFrameLayout
        android:id="@+id/logo4"
        android:layout_width="@dimen/logo_block_w"
        android:layout_height="@dimen/logo_block_h"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:padding="3dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logo_block"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:padding="3dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logo_block"
            app:tint="@color/l_kit_yellow"/>
    </com.example.square.view.AnimateFrameLayout>
</view>
