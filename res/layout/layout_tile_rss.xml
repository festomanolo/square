<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#00a5ff"
    android:layout_width="@dimen/dp100"
    android:layout_height="@dimen/dp100">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:id="@+id/textEmpty"
        android:background="@drawable/l_kit_ripple_rect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/empty"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/btnRefresh"
        android:background="@drawable/l_kit_ripple_oval"
        android:padding="@dimen/menu_button_padding_large"
        android:layout_width="@dimen/menu_button_size"
        android:layout_height="@dimen/menu_button_size"
        android:src="@drawable/ic_refresh"
        android:contentDescription="refresh"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/btnToTop"
        android:background="@drawable/l_kit_ripple_oval"
        android:padding="@dimen/menu_button_padding_large"
        android:layout_width="@dimen/menu_button_size"
        android:layout_height="@dimen/menu_button_size"
        android:src="@drawable/ic_align_top"
        android:contentDescription="to top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnError"
        android:id="@+id/viewLocked"
        android:background="@drawable/bg_pro_badge_error"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="5dp"
        android:paddingBottom="4dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRO"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
