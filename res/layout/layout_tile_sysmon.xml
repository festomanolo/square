<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ff000000"
    android:layout_width="@dimen/dp100"
    android:layout_height="200dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutCore"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="@dimen/text_normal"
            android:textColor="#fff"
            android:id="@+id/textCPU"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cpu"/>
        <com.example.square.HorizontalPercentView
            android:id="@+id/percentCPU"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="@dimen/text_normal"
            android:textColor="#fff"
            android:id="@+id/textRAM"
            android:paddingTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ram"/>
        <com.example.square.HorizontalPercentView
            android:id="@+id/percentRAM"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="@dimen/text_normal"
            android:textColor="#fff"
            android:id="@+id/textStorage"
            android:paddingTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/storage"/>
        <com.example.square.HorizontalPercentView
            android:id="@+id/percentStorage"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="@dimen/text_normal"
            android:textColor="#fff"
            android:id="@+id/textSdCard"
            android:paddingTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sdcard"/>
        <com.example.square.HorizontalPercentView
            android:id="@+id/percentSdCard"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            style="?android:attr/progressBarStyleHorizontal"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="@dimen/text_normal"
                android:textColor="#fff"
                android:id="@+id/textBattery"
                android:paddingTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery"/>
            <ImageView
                android:id="@+id/imageCharging"
                android:layout_width="15dp"
                android:layout_height="15dp"/>
        </LinearLayout>
        <com.example.square.HorizontalPercentView
            android:id="@+id/percentBattery"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            style="?android:attr/progressBarStyleHorizontal"/>
    </LinearLayout>
    <TextView
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnError"
        android:id="@+id/viewLocked"
        android:background="@drawable/bg_pro_badge_error"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="5dp"
        android:paddingBottom="4dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRO"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
