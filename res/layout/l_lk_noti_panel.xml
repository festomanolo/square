<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/panel"
    android:background="@drawable/l_kit_bg_popup_menu"
    android:layout_width="@dimen/l_kit_popupmenu_width"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:animateLayoutChanges="true"
    android:elevation="@dimen/l_kit_popupmenu_elevation">
    <FrameLayout
        android:id="@+id/frameTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            android:id="@+id/textTitle"
            android:paddingLeft="20dp"
            android:paddingTop="24dp"
            android:paddingRight="20dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Title"
            android:textAllCaps="true"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btnClearAll"
            android:background="?android:attr/selectableItemBackground"
            android:padding="@dimen/l_kit_popupmenu_icon_padding"
            android:layout_width="@dimen/l_kit_popupmenu_icon_size"
            android:layout_height="@dimen/l_kit_popupmenu_icon_size"
            android:layout_marginRight="20dp"
            android:src="@drawable/ic_lk_clear_all"
            android:layout_marginEnd="20dp"/>
    </FrameLayout>
    <com.example.square.view.AnimateListView
        android:id="@+id/listItems"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:listSelector="?android:attr/selectableItemBackground"
        android:divider="#7fc0c0c0"
        android:dividerHeight="1dp"
        android:layout_below="@+id/frameTitle"/>
    <FrameLayout
        android:id="@+id/frameOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/listItems"/>
</RelativeLayout>
