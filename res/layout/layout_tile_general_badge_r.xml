<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp100"
    android:layout_height="@dimen/dp100">
    <com.example.square.RoundedMarqueeImageView
        android:id="@+id/imageFull"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        custom:riv_corner_radius="@dimen/tile_round_radius"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="@dimen/text_normal"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/textNoti"
        android:padding="3dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:maxLines="3"
        android:layout_centerHorizontal="true"
        custom:layout_constraintBottom_toTopOf="@+id/textLabel"
        custom:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/layoutIcon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        custom:layout_constraintBottom_toBottomOf="parent"
        custom:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_margin="@dimen/margin_for_badge"/>
            <com.example.square.NotiCountView
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="@dimen/text_normal"
                android:textColor="?attr/colorOnError"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/textCount"
                android:background="@drawable/bg_deco_count"
                android:visibility="gone"
                android:layout_width="@dimen/badge_size"
                android:layout_height="@dimen/badge_size"
                android:text="0"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|bottom"
                android:id="@+id/dot"
                android:background="@drawable/bg_deco_bubble"
                android:padding="@dimen/bubble_padding"
                android:visibility="invisible"
                android:layout_width="@dimen/badge_size"
                android:layout_height="@dimen/badge_size"/>
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="@dimen/text_normal"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/textLabel"
        android:paddingLeft="@dimen/tile_padding"
        android:paddingRight="@dimen/tile_padding"
        android:paddingBottom="@dimen/tile_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        custom:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
