###### Class defpackage.r24 (r24)
.class public final Lr24;
.super Lq24;


# direct methods
.method public constructor <init>()V
    .registers 1

    invoke-direct {p0}, Lq24;-><init>()V

    return-void
.end method

.method public constructor <init>(Lf34;)V
    .registers 2

    invoke-direct {p0, p1}, Lq24;-><init>(Lf34;)V

    return-void
.end method
